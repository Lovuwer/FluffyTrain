# Redis Configuration
TITAN_REDIS_HOST=localhost
TITAN_REDIS_PORT=6379
TITAN_REDIS_PASSWORD=
TITAN_REDIS_POOL_SIZE=10

# PostgreSQL Configuration
TITAN_POSTGRES_HOST=localhost
TITAN_POSTGRES_PORT=5432
TITAN_POSTGRES_USER=titan
TITAN_POSTGRES_PASSWORD=your_password_here
TITAN_POSTGRES_DATABASE=titan

# API Configuration
TITAN_API_PORT=8080
TITAN_API_READ_TIMEOUT=30s
TITAN_API_WRITE_TIMEOUT=30s

# Worker Configuration
TITAN_WORKER_CONCURRENCY=10
TITAN_WORKER_POLL_INTERVAL=1s
TITAN_WORKER_JOB_TIMEOUT=30s

# Logging Configuration
TITAN_LOGGING_LEVEL=info
TITAN_LOGGING_FORMAT=json

# Environment
ENVIRONMENT=development
